{
  "name": "ctf-ui",
  "version": "0.6.0",
  "description": "Gedeelde UI-componenten en utilities voor de CTF web-apps (Café Theater Festival)",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./api": "./dist/api.js",
    "./i18n": "./dist/i18n.js",
    "./components": "./dist/components.js",
    "./tekst": "./dist/tekst.mjs",
    "./opmaak": "./dist/opmaak.js",
    "./push": "./dist/push.js",
    "./vite": "./vite.mjs",
    "./sw.js": "./sw.js",
    "./tailwind-preset": "./tailwind-preset.js"
  },
  "files": [
    "dist",
    "tailwind-preset.js",
    "vite.mjs",
    "sw.js"
  ],
  "scripts": {
    "build": "babel src -d dist --extensions .js,.mjs --keep-file-extension"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@babel/cli": "^7.25.0",
    "@babel/core": "^7.25.0",
    "@babel/preset-react": "^7.25.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LdeGroen/ctf-ui.git"
  },
  "license": "MIT",
  "dependencies": {
    "dompurify": "^3.4.17"
  }
}
